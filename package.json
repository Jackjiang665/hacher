{
  "name": "hacher-workbench",
  "version": "1.3.1",
  "description": "hacher 个人智能工作台 Windows 桌面版",
  "main": "main.cjs",
  "author": "hacher",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prepack": "node tools/prepare-native.cjs",
    "pack": "node tools/pack.cjs"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.hacher.workbench",
    "productName": "hacher",
    "asar": false,
    "electronDist": ".electron-dist",
    "npmRebuild": false,
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "assets/**",
      "vendor/**",
      "tools/**",
      "CLAUDE.md",
      "!node_modules/@xterm/**",
      "!node_modules/@homebridge/node-pty-prebuilt-multiarch/prebuilds/**",
      "!node_modules/@homebridge/node-pty-prebuilt-multiarch/src/**",
      "!node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*.map",
      "!node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*.test.js"
    ],
    "directories": {
      "output": "release-build"
    },
    "win": {
      "icon": "assets/hacher.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "hacher-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "hacher",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  }
}
